import 'dart:convert';

// 14-agregacao.dart
// Agregação e Composição

class Dependente {
  late String _nome;

  Dependente(String nome) {
    this._nome = nome;
  }

  Map<String, dynamic> toJson() {
    return {
      'nome': _nome,
    };
  }
}

class Funcionario {
  late String _nome;
  late List<Dependente> _dependentes;

  Funcionario(String nome, List<Dependente> dependentes) {
    this._nome = nome;
    this._dependentes = dependentes;
  }

  Map<String, dynamic> toJson() {
    return {
      'nome': _nome,
      'dependentes': _dependentes,
    };
  }
}

class EquipeProjeto {
  late String _nomeProjeto;
  late List<Funcionario> _funcionarios;

  EquipeProjeto(String nomeprojeto, List<Funcionario> funcionarios) {
    _nomeProjeto = nomeprojeto;
    _funcionarios = funcionarios;
  }

  Map<String, dynamic> toJson() {
    return {
      'nomeProjeto': _nomeProjeto,
      'funcionarios': _funcionarios,
    };
  }
}

void main() {
//objetos dependentes
  Dependente dependente1 = Dependente("Márcio");
  Dependente dependente2 = Dependente("Andréia");
  Dependente dependente3 = Dependente("Matheus");
  Dependente dependente4 = Dependente("Arthur");

//objetos funcionários e associação com os dependentes

  Funcionario funcionario1 = Funcionario(
    "Théo",
    [dependente1, dependente2],
  );

  Funcionario funcionario2 = Funcionario(
    "Cecília",
    [dependente3],
  );

  Funcionario funcionario3 = Funcionario(
    "Theovanira",
    [dependente4],
  );

//lista de funcionários
  List<Funcionario> funcionarios = [
    funcionario1,
    funcionario2,
    funcionario3,
  ];
//objeto Equipe Projeto
  EquipeProjeto equipeProjeto = EquipeProjeto(
    "Projeto Um",
    funcionarios,
  );
//print em formato json do objeto Equipe Projeto 
  print(jsonEncode(equipeProjeto));
}
